{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sunkiss",
  "version": "0.1.0",
  "identifier": "dev.sunkiss.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "beforeBundleCommand": "file-provider/build.sh"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "sunkiss",
        "width": 800,
        "height": 600,
        "transparent": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {
        "PlugIns/SunkissFiles.appex": "../file-provider/build/SunkissFiles.appex"
      }
    }
  }
}
